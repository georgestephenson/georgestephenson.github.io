source "https://rubygems.org"

# Matches the exact Jekyll setup GitHub Pages uses to build your site,
# so local previews look like the deployed site.
gem "github-pages", group: :jekyll_plugins

# Lock down to keep local builds reproducible on newer Ruby versions.
gem "webrick"

# Quality gate: validates internal links, image references, alt text and OG tags
# against the built _site. Run via `bundle exec htmlproofer`.
gem "html-proofer", "~> 5.0", group: :test
